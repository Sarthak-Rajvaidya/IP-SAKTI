# =============================================================================
# IP-SAKTI backend configuration
# Copy this file to `.env` and fill in the values you have.
# The app is designed to boot even with missing keys — features that need a
# missing key/service return a clear configuration error instead of crashing.
# =============================================================================

# --- Gemini LLM -------------------------------------------------------------
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY= 
# A currently available free-tier Flash model. Change if Google renames/retires it.
GEMINI_MODEL=gemini-2.0-flash

# --- Local multilingual embeddings ------------------------------------------
# BAAI/bge-m3 is the preferred multilingual embedding model (large, ~2.2GB).
# If your machine is low on RAM/CPU, switch to the lighter fallback:
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=BAAI/bge-m3

# --- Qdrant vector database ---------------------------------------------------
# Run locally via `docker compose up qdrant`, or install Qdrant standalone.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ip_sakti_knowledge

# --- Language ------------------------------------------------------------------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr

# --- RAG tuning ------------------------------------------------------------------
RAG_TOP_K=8
RAG_MIN_RELEVANCE=0.45
RAG_MIN_CONFIDENCE=0.45

# --- CORS ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Bhashini (OPTIONAL — leave blank to use Gemini for multilingual generation)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_URL=

# --- App -----------------------------------------------------------------------
APP_ENV=development
DEBUG_MODE=false

# --- Local persistence (SQLite; see README for future PostgreSQL migration) ----
SQLITE_PATH=./data/ip_sakti.db
